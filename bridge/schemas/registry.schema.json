{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-meter.app/schemas/TokenMeter/1.2.0/registry.schema.json",
  "title": "TokenMeter/1.2.0 provider capability registry",
  "description": "Capability metadata for the locked provider set. Carries no model catalog, no credentials and no endpoint policy. connectorTransport \"builtin-<providerId>\" marks a provider dispatched by its builtin provider module; authMethods/credentialKinds mirror the auth surface the module implements. The unreviewed enum members appear only on newly discovered providers pending capability review; sync may never promote support tier, authorization basis or polling policy on its own. Pending-review providers carry empty authMethods/credentialKinds until a module exists. The registry schemaVersion is versioned independently from the TokenMeter bridge wire schemaVersion in common.schema.json.",
  "$defs": {
    "supportTier": { "enum": ["supported", "bestEffort", "conditional", "excluded"] },
    "connectorTransport": {
      "enum": [
        "builtin-github-billing",
        "builtin-alibaba-token-plan",
        "builtin-anthropic",
        "builtin-cursor",
        "builtin-google-antigravity",
        "builtin-google-gemini-cli",
        "builtin-kimi-code",
        "builtin-minimax-code",
        "builtin-ollama",
        "builtin-ollama-cloud",
        "builtin-openai-codex",
        "builtin-opencode-go",
        "builtin-synthetic",
        "builtin-umans",
        "builtin-xai-oauth",
        "builtin-zai",
        "external"
      ]
    },
    "registryAuthMethod": { "enum": ["apiKey", "browser", "device"] },
    "registryCredentialKind": { "enum": ["none", "bearer", "apiKey", "oauth"] },
    "registryProductKind": {
      "enum": ["quota", "billingUsage", "organizationUsage", "localActivity", "unreviewed"]
    },
    "registrySourceKind": {
      "enum": [
        "documentedApi",
        "firstPartyApi",
        "privateApi",
        "browserSession",
        "noQuotaApi",
        "localObserved",
        "unreviewed"
      ]
    },
    "authorizationBasis": {
      "enum": ["documentedUserBilling", "subscriptionOAuth", "apiKey", "browserSession", "deviceNone", "unreviewed"]
    },
    "declaredWindow": { "enum": ["5h", "7d", "daily", "weekly", "monthly"] },
    "pollingPolicy": { "enum": ["authorizedDefault", "notPolled"] },
    "providerCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "supportTier",
        "connectorTransport",
        "authMethods",
        "credentialKinds",
        "productKind",
        "sourceKind",
        "authorizationBasis",
        "declaredUnit",
        "declaredWindows",
        "pollingPolicy"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "supportTier": { "$ref": "#/$defs/supportTier" },
        "connectorTransport": { "$ref": "#/$defs/connectorTransport" },
        "authMethods": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/registryAuthMethod" }
        },
        "credentialKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/registryCredentialKind" }
        },
        "productKind": { "$ref": "#/$defs/registryProductKind" },
        "sourceKind": { "$ref": "#/$defs/registrySourceKind" },
        "authorizationBasis": { "$ref": "#/$defs/authorizationBasis" },
        "declaredUnit": { "$ref": "common.schema.json#/$defs/usageUnit" },
        "declaredWindows": {
          "type": "array",
          "items": { "$ref": "#/$defs/declaredWindow" },
          "uniqueItems": true
        },
        "pollingPolicy": { "$ref": "#/$defs/pollingPolicy" },
        "pendingCapabilityReview": { "const": true }
      }
    },
    "providersListing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "providers"],
      "properties": {
        "schemaVersion": { "const": "1.2.0" },
        "providers": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/providerCapability" }
        }
      }
    },
    "capabilityManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "syncedFromSha", "providers"],
      "properties": {
        "schemaVersion": { "const": "1.2.0" },
        "syncedFromSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "providers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/providerCapability" }
        }
      }
    }
  }
}
