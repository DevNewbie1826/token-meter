{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-meter.app/schemas/TokenMeter/1.2.0/registry.schema.json",
  "title": "TokenMeter/1.2.0 provider capability registry",
  "description": "Capability metadata for the 17 reviewed implementations. Carries no model catalog, credentials or pending discovery fields. Newly discovered integrations belong exclusively to discovery.schema.json, never this shipped manifest or listing. Sync may never promote support, authorization or polling policy. declaredUnit is unknown for mixed or unspecified amounts; individual usage windows retain their actual units. Registry schemaVersion is independent from the bridge wire schemaVersion.",
  "$defs": {
    "supportTier": { "enum": ["supported", "bestEffort", "conditional", "excluded"] },
    "connectorTransport": {
      "enum": [
        "builtin-github-billing",
        "builtin-alibaba-token-plan",
        "builtin-anthropic",
        "builtin-cursor",
        "builtin-google-antigravity",
        "builtin-google-gemini-cli",
        "builtin-kimi-code",
        "builtin-minimax-code",
        "builtin-nekos",
        "builtin-ollama",
        "builtin-ollama-cloud",
        "builtin-openai-codex",
        "builtin-opencode-go",
        "builtin-synthetic",
        "builtin-umans",
        "builtin-xai-oauth",
        "builtin-zai",
        "external"
      ]
    },
    "registryAuthMethod": { "enum": ["apiKey", "browser", "device"] },
    "registryCredentialKind": { "enum": ["none", "bearer", "apiKey", "oauth"] },
    "registryProductKind": {
      "enum": ["quota", "billingUsage", "organizationUsage", "localActivity", "unreviewed"]
    },
    "registrySourceKind": {
      "enum": [
        "documentedApi",
        "firstPartyApi",
        "privateApi",
        "browserSession",
        "noQuotaApi",
        "localObserved",
        "unreviewed"
      ]
    },
    "authorizationBasis": {
      "enum": ["documentedUserBilling", "subscriptionOAuth", "apiKey", "browserSession", "deviceNone", "unreviewed"]
    },
    "declaredWindow": { "enum": ["3h", "5h", "7d", "daily", "weekly", "monthly"] },
    "pollingPolicy": { "enum": ["authorizedDefault", "notPolled"] },
    "providerCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "supportTier",
        "connectorTransport",
        "authMethods",
        "credentialKinds",
        "productKind",
        "sourceKind",
        "authorizationBasis",
        "declaredUnit",
        "declaredWindows",
        "pollingPolicy"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "supportTier": { "$ref": "#/$defs/supportTier" },
        "connectorTransport": { "$ref": "#/$defs/connectorTransport" },
        "authMethods": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/registryAuthMethod" }
        },
        "credentialKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/registryCredentialKind" }
        },
        "productKind": { "$ref": "#/$defs/registryProductKind" },
        "sourceKind": { "$ref": "#/$defs/registrySourceKind" },
        "authorizationBasis": { "$ref": "#/$defs/authorizationBasis" },
        "declaredUnit": { "$ref": "common.schema.json#/$defs/usageUnit" },
        "declaredWindows": {
          "type": "array",
          "items": { "$ref": "#/$defs/declaredWindow" },
          "uniqueItems": true
        },
        "pollingPolicy": { "$ref": "#/$defs/pollingPolicy" }
      }
    },
    "providersListing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "providers"],
      "properties": {
        "schemaVersion": { "const": "1.2.0" },
        "providers": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "items": { "$ref": "#/$defs/providerCapability" }
        }
      }
    },
    "capabilityManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "syncedFromSha", "providers"],
      "properties": {
        "schemaVersion": { "const": "1.2.0" },
        "syncedFromSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "providers": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "items": { "$ref": "#/$defs/providerCapability" }
        }
      }
    }
  }
}
